<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="acquirer_form_swedbankpay" model="ir.ui.view">
            <field name="name">acquirer.form.swedbankpay</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <group name="provider_credentials" position="inside">
                    <group  invisible="code != 'swedbankpay'">
                        <field name="swedbankpay_merchant_id" />
                        <field name="swedbankpay_account_nr" />
                        <field name="swedbankpay_view" />
<!--                        <field name="swedbankpay_key"/>-->
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>

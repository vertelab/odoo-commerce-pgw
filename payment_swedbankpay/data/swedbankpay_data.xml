<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="payment_method_swedbank" model="payment.method">
             <field name="name">Swedbank</field>
             <field name="code">swedbankpay</field>
             <field name="sequence">20</field>
             <field name="active">True</field>
             <field name="image" type="base64" file="payment_swedbankpay/static/src/img/swedbankpay_icon.png"/>
        </record>



        <record id="acquirer_swedbankpay" model="payment.provider">
            <field name="name">Swedbank Pay</field>
            <field name="image_128" type="base64" file="payment_swedbankpay/static/src/img/swedbankpay_icon.png" />
            <field name="code">swedbankpay</field>
            <field name="module_id" ref="base.module_payment_swedbankpay"/>
            <field name="swedbankpay_key">xxxx</field>
            <field name="company_id" ref="base.main_company" />
            <field name="redirect_form_view_id" ref="redirect_form" />
            <field name="sequence">2</field>
            <field name="module_id">1</field>
            <field name="payment_method_ids"  eval="[Command.set([ref('payment_swedbankpay.payment_method_swedbank')])]"/>
        </record>
    </data>
</odoo>
